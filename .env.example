# Brightloop Subscription Management System Environment Variables
SECRET_KEY=django-insecure-brightloop-hackathon-secret-key-change-in-prod
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database: sqlite3 by default, set postgresql://user:pass@localhost:5432/brightloop for Postgres
DATABASE_URL=sqlite:///db.sqlite3

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Email backend (console for development)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

